# ─────────────────────────────────────────────
# Peculiar Register — Environment Variables
# Copy this file to ../.env (one level up, in the
# "Peculiar Register" folder) and fill in the values.
# ─────────────────────────────────────────────

# ── Supabase ──────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-key
# Server-side only. Required for admin writes when Supabase RLS blocks anon inserts/updates.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Flask ─────────────────────────────────────
FLASK_DEBUG=0
JWT_SECRET=change-this-to-a-long-random-secret
ADMIN_REGISTER_SECRET=change-this-too
SCHOOL_NAME=Peculiar School

# ── Gmail SMTP ────────────────────────────────
# Use a Gmail App Password (not your normal password).
# Enable 2FA first → myaccount.google.com → Security → App Passwords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-school@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── Twilio WhatsApp ───────────────────────────
# Found in: console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155552671
