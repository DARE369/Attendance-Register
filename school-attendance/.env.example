# ─────────────────────────────────────────────
# Peculiar Register — Environment Variables
# Copy this file to ../.env (one level up, in the
# "Peculiar Register" folder) and fill in the values.
# ─────────────────────────────────────────────

# ── Supabase ──────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-key
# Server-side only. Required for admin writes when Supabase RLS blocks anon inserts/updates.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Flask ─────────────────────────────────────
FLASK_DEBUG=0
JWT_SECRET=change-this-to-a-long-random-secret
ADMIN_REGISTER_SECRET=change-this-too
SCHOOL_NAME=Peculiar School

# ── Gmail SMTP ────────────────────────────────
# Use a Gmail App Password (not your normal password).
# Enable 2FA first → myaccount.google.com → Security → App Passwords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-school@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── D7 Networks WhatsApp ──────────────────────
# Found in: app.d7networks.com → API tokens
D7_API_TOKEN=your-d7-api-token
D7_WHATSAPP_FROM=+2348012345678

# ── Staff mobile sign-in ──────────────────────
# Different from JWT_SECRET. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
STAFF_JWT_SECRET=change-this-to-another-long-random-secret
# Final app domain, no scheme. Passkeys are tied to it forever, so set it before staff enrol.
# Production: peculiar-register.vercel.app (origin https://peculiar-register.vercel.app)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=LPS Staff
# Full origin of the frontend, with scheme
WEBAUTHN_ORIGIN=http://localhost:5173
# Sent by the scheduled reminders job as X-Cron-Secret
CRON_SECRET=change-this-too
